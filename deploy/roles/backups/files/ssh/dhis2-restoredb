#!/bin/bash
#         ____  __  ______________
#        / __ \/ / / /  _/ ___/__ \
#       / / / / /_/ // / \__ \__/ /
#      / /_/ / __  // / ___/ / __/
#     /_____/_/ /_/___//____/____/
#
#    DHIS2 restore database backup (for local PostgreSQL)

set -euo pipefail

PROG=$(basename "$0")
BACKUPFILE="${1:-}"
DB="${2:-}"

usage() {
  echo "Usage: $PROG <backup file (tar.gz)> <dbname>"
  echo "  backup file: database dump in tar gzip format"
  echo "  dbname: the name of the database to restore"
  echo "Options:"
  echo "  -h, --help        Display this help message"
  echo ""
  echo "Prerequisites:"
  echo "  - PostgreSQL must be installed and running directly on this machine."
  echo "  - The 'postgres' system user must exist and have permissions to manage databases via 'sudo -u postgres'."
  echo "  - The DHIS2 database role (e.g. 'dhis2', matching 'dbname') must already exist in PostgreSQL."
  echo "  - Stop the DHIS2 instance (Tomcat) before restoring, so nothing holds open connections to the target database."
  echo "  - The 'psql', 'dropdb', and 'createdb' commands must be on PATH."
}

# ---
# Argument and help handling
# ---

if [ "$#" -eq 0 ] || [ "$BACKUPFILE" = "-h" ] || [ "$BACKUPFILE" = "--help" ]; then
  usage
  exit 0
fi

if [ -z "$BACKUPFILE" ] || [ -z "$DB" ]; then
  echo "Error: missing required arguments." >&2
  usage
  exit 1
fi

if [ ! -f "$BACKUPFILE" ]; then
  echo "Error: backup file '$BACKUPFILE' not found." >&2
  exit 1
fi

if ! gzip -t "$BACKUPFILE" 2>/dev/null; then
  echo "Error: '$BACKUPFILE' is not a valid gzip file (corrupt or truncated?)." >&2
  exit 1
fi

echo "---"
echo "Restoring database '$DB' from '$BACKUPFILE'..."
echo "---"

# ---
# Database operations
# ---

# Only drop if it actually exists - a fresh restore target is not an error.
# If it exists but can't be dropped (most likely: DHIS2/Tomcat still holding
# open connections to it), that IS an error and must stop here, not be
# silently swallowed into a createdb that will just fail for a confusing
# reason.
DB_EXISTS=$(sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$DB'" postgres)

if [ "$DB_EXISTS" = "1" ]; then
  echo "Dropping existing database '$DB'..."
  if ! sudo -u postgres dropdb "$DB"; then
    echo "Error: failed to drop database '$DB'." >&2
    echo "If it still has open connections, stop the DHIS2 instance (Tomcat) and try again." >&2
    exit 1
  fi
else
  echo "Database '$DB' does not exist yet - skipping drop."
fi

echo "Creating new database '$DB' owned by '$DB'..."
if ! sudo -u postgres createdb -O "$DB" "$DB"; then
  echo "Error: failed to create database '$DB'. Does role '$DB' exist in PostgreSQL?" >&2
  exit 1
fi

echo "Restoring data into '$DB'..."
if ! zcat "$BACKUPFILE" | grep -v 'ALTER .* OWNER' | sudo -u postgres psql "$DB"; then
  echo "Error: restore failed partway through. '$DB' may be left in a partial state." >&2
  exit 1
fi

echo "Reassigning objects owned by 'root' to '$DB'..."
if ! echo "REASSIGN OWNED BY root TO \"$DB\"" | sudo -u postgres psql "$DB"; then
  echo "Error: failed to reassign ownership." >&2
  exit 1
fi

echo "---"
echo "Database restore for '$DB' completed successfully."
echo "---"
