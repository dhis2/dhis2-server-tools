user www-data;
worker_processes  auto;

error_log  /usr/local/openresty/nginx/logs/error.log notice;
pid        /usr/local/openresty/nginx/logs/nginx.pid;

events {
    worker_connections  1024;
}

http {
    server_tokens off;
    include       mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    log_format performance '$remote_addr\t$remote_user\t[$time_local]\t"$request"\t'
                           '$status\t$body_bytes_sent\t"$http_referer"\t"$http_user_agent"\t'
                           '$request_time';

    # Site-specific http{}-level configuration: extra log formats, maps,
    # lua_shared_dict, limit_req_zone, proxy_cache_path, ... Ansible creates
    # http.d/ but never writes files into it, so anything placed there
    # survives playbook runs (static/<fqdn>.conf is the server{}-level
    # equivalent). Included before access_log so a custom log_format defined
    # here can be selected with openresty_access_log_format.
    include /usr/local/openresty/nginx/conf/http.d/*.conf;

    access_log /usr/local/openresty/nginx/logs/perf.log {{ openresty_access_log_format | default('performance') }};

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml
        application/rss+xml
        application/atom+xml
        application/wasm
        image/svg+xml;

    include /usr/local/openresty/nginx/conf/conf.d/*.conf;
}
